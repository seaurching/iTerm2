      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "set -eu&#10;cd &quot;$SRCROOT/plists&quot;&#10;echo &quot;cp -f dev-iTerm2.plist iTerm2.plist&quot;&#10;cp -f dev-iTerm2.plist iTerm2.plist&#10;for src in development/*.lproj/*; do&#10;    [ -f &quot;$src&quot; ] || continue&#10;    #development/zh-Hans.lproj/xxx -&gt; zh-Hans.lproj&#10;    lproj=&quot;${src#development/}&quot;; lproj=&quot;${lproj%%/*}&quot; &#10;    file=&quot;${src##*/}&quot;&#10;    mkdir -p &quot;$lproj&quot;&#10;    dest=&quot;$lproj/$file&quot;&#10;    cp -f &quot;$src&quot; &quot;$dest&quot;&#10;    echo &quot;Pre-action: &#x540c;&#x6b65; development/${lproj}/${file} -&gt; ${lproj}/${file}&quot;&#10;done&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "874206460564169600CFC3F1"
                     BuildableName = "iTerm2.app"
                     BlueprintName = "iTerm2"
                     ReferencedContainer = "container:iTerm2.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <AdditionalOptions>
