/* Alert: keyboard input will be broadcast */
"Keyboard input will be sent to %@." = "鍵盤輸入將傳送到%@。";

/* Alert button: OK */
"OK" = "確定";

/* Broadcast destination: no sessions */
"no sessions" = "無工作階段";

/* Broadcast destination: all panes in all tabs */
"all panes in all tabs in this window" = "此視窗中所有分頁的所有窗格";

/* Broadcast destination: N panes across all tabs */
"%@ panes across all tabs in this window" = "此視窗所有分頁中的 %@ 個窗格";

/* Broadcast destination: all panes in current tab */
"all panes in the current tab" = "目前分頁中的所有窗格";

/* Broadcast destination: N panes in current tab */
"%@ panes in the current tab" = "目前分頁中的 %@ 個窗格";

/* Broadcast destination: multiple sessions */
"multiple sessions" = "多個工作階段";

