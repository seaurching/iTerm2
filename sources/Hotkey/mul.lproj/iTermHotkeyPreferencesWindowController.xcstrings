    "6tA-bg-olR.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Note: the window is reopened only if it was closed because another app became active.\"; ObjectID = \"6tA-bg-olR\";",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: the window is reopened only if it was closed because another app became active."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：仅当窗口因其他应用变为活动状态而关闭时，才会重新打开该窗口。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：僅當視窗因其他應用變為活動狀態而關閉時，才會重新開啟該視窗。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：仅当窗口因其他应用变为活动状态而关闭时，才会重新打开该窗口。"
          }
        },
        "zh-Hans-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：仅当窗口因其他应用变为活动状态而关闭时，才会重新打开该窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：僅當視窗因其他應用變為活動狀態而關閉時，才會重新開啟該視窗。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：僅當視窗因其他應用變為活動狀態而關閉時，才會重新開啟該視窗。"
          }
        }
      }
    },
