    "dHI-y9-qMI.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"When you press the hotkey bound to this profile a dedicated window will show or hide. Each profile with a hotkey controls its own Hotkey Window.\"; ObjectID = \"dHI-y9-qMI\";",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you press the hotkey bound to this profile a dedicated window will show or hide. Each profile with a hotkey controls its own Hotkey Window."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您按下绑定到此配置文件的快捷键时，将显示或隐藏一个专用窗口。每个具有快捷键的配置文件控制其自己的快捷键窗口。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您按下綁定到此設定檔的快捷鍵時，將顯示或隱藏一個專用視窗。每個具有快捷鍵的設定檔控制其自己的快捷鍵視窗。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您按下绑定到此配置文件的快捷键时，将显示或隐藏一个专用窗口。每个具有快捷键的配置文件控制其自己的快捷键窗口。"
          }
        },
        "zh-Hans-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您按下绑定到此配置文件的快捷键时，将显示或隐藏一个专用窗口。每个具有快捷键的配置文件控制其自己的快捷键窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您按下綁定到此設定檔的快捷鍵時，將顯示或隱藏一個專用視窗。每個具有快捷鍵的設定檔控制其自己的快捷鍵視窗。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您按下綁定到此設定檔的快捷鍵時，將顯示或隱藏一個專用視窗。每個具有快捷鍵的設定檔控制其自己的快捷鍵視窗。"
          }
        }
      }
    },
