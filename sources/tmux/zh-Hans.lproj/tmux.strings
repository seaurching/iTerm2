"Can't open window: missing layout" = "无法打开窗口：缺少布局";
"Error parsing layout %@" = "解析布局出错 %@";
"Error: malformed history line from tmux." = "错误：来自 tmux 的历史行格式错误。";
"See Console.app for details" = "详情请查看 Console.app";
"Open in Window" = "在窗口中打开";
"Open in Windows" = "在多个窗口中打开";
"New Session" = "新建会话";
