"Malformed command (expected %%window-renamed id new_name): \"%@\"" = "格式錯誤的命令（預期 %%window-renamed id new_name）：“%@”";
"Malformed command (expected %%session-renamed id name): \"%@\"" = "格式錯誤的命令（預期 %%session-renamed id name）：“%@”";
