"Malformed command (expected %%layout-change <window> <layout> [<window_visible_layout> <window_flags>]): \"%@\"" = "格式錯誤的命令（預期 %%layout-change <window> <layout> [<window_visible_layout> <window_flags>]）：“%@”";
"Malformed command (expected %%window-add id): \"%@\"" = "格式錯誤的命令（預期 %%window-add id）：“%@”";
