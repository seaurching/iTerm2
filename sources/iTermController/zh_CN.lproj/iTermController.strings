/* Menu item: overflow profiles not shown */
"[%d profiles not shown]" = "[%d 个配置文件未显示]";

/* Menu item: open all profiles */
"Open All" = "全部打开";

/* Menu item: open all profiles in new window */
"Open All in New Window" = "在新窗口中全部打开";

/* Alert: about to open many profiles */
"You are about to open %d profiles." = "您即将打开 %d 个配置文件。";

/* Alert button: OK */
"OK" = "确定";

/* Notification title: creating a tab */
"Creating a tab" = "正在创建标签页";

/* Notification detail: tab preference now respected */
"The system preference to open a tab instead of a window is now respected in iTerm2." = "iTerm2 现在遵循系统偏好中“打开标签页而非窗口”的设置。";

/* Alert heading: open untrusted arrangement */
"Open the arrangement “%@”?" = "打开布局“%@”？";

/* Alert button: open the arrangement */
"Open" = "打开";

/* Trust gate body: explanation of arrangement risks */
"Window arrangements embed session profiles, which can run commands, connect to remote hosts, and configure triggers or smart-selection actions that execute when the terminal sees matching output. Opening an arrangement from an untrusted source is equivalent to running a program they gave you." = "窗口布局嵌入了会话配置文件，这些配置文件可以运行命令、连接远程主机，并配置触发器或智能选择操作，在终端看到匹配输出时执行。打开来自不可信来源的布局等同于运行他们给你的程序。";

/* Trust gate body: list header */
"This arrangement contains:" = "此布局包含：";

/* Trust gate body: trust warning */
"Open it only if you trust where it came from." = "仅当您信任其来源时才打开它。";

/* Trust gate finding: embedded session profile */
"embedded session profile" = "嵌入的会话配置文件";

/* Trust gate finding: custom command */
"custom command" = "自定义命令";

/* Trust gate finding suffix: custom command */
" that will run when the arrangement opens" = "，将在布局打开时运行";

/* Trust gate finding: SSH connection */
"SSH connection" = "SSH 连接";

/* Trust gate finding suffix: SSH connection */
" that will be opened automatically" = "，将自动打开";

/* Trust gate finding: session */
"session" = "会话";

/* Trust gate finding suffix: session initial text */
" with text that will be typed into the terminal on startup" = "，带有启动时将输入到终端的文本";

/* Trust gate finding: trigger */
"trigger" = "触发器";

/* Trust gate finding suffix: trigger */
" that runs actions when matching output appears" = "，在出现匹配输出时运行操作";

/* Trust gate finding: smart-selection rule */
"smart-selection rule" = "智能选择规则";

/* Trust gate finding suffix: smart-selection rule */
" with custom actions" = "，带有自定义操作";

/* Trust gate: count + noun (singular) */
"%d %@" = "%d 个%@";

/* Trust gate: count + noun (plural) */
"%d %@s" = "%d 个%@";
