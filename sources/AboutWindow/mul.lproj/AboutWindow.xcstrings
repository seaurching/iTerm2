        "XqE-kC-hnW.textStorage.attributedString.content": {
            "comment": "TextView content with Patreon and GitHub Sponsors links",
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 is supported by these backers on <a href=\"https://patreon.com/gnachman\">Patreon</a> and <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>:"
                    }
                },
                "zh-Hans": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 由以下支持者在 <a href=\"https://patreon.com/gnachman\">Patreon</a> 和 <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a> 上支持："
                    }
                },
                "zh-Hant": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 由以下支持者在 <a href=\"https://patreon.com/gnachman\">Patreon</a> 和 <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a> 上支持："
                    }
                },
                "ja": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 は <a href=\"https://patreon.com/gnachman\">Patreon</a> と <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a> の以下のサポーターに支えられています："
                    }
                },
                "ko": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2는 <a href=\"https://patreon.com/gnachman\">Patreon</a> 및 <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>의 다음 후원자들의 지원을 받습니다:"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 est soutenu par ces contributeurs sur <a href=\"https://patreon.com/gnachman\">Patreon</a> et <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a> :"
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 wird von diesen Unterstützern auf <a href=\"https://patreon.com/gnachman\">Patreon</a> und <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a> unterstützt:"
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 es apoyado por estos patrocinadores en <a href=\"https://patreon.com/gnachman\">Patreon</a> y <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>:"
                    }
                },
                "pt": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 é apoiado por estes apoiadores no <a href=\"https://patreon.com/gnachman\">Patreon</a> e <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>:"
                    }
                },
                "ru": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 поддерживается следующими спонсорами на <a href=\"https://patreon.com/gnachman\">Patreon</a> и <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>:"
                    }
                },
                "ar": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "iTerm2 مدعوم من هؤلاء الداعمين على <a href=\"https://patreon.com/gnachman\">Patreon</a> و <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>:"
                    }
                },
                "zh_CN": {
