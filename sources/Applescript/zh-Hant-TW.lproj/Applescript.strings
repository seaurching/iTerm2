/* iTermApplescriptPythonCommands.m - Python 指令碼命令 */
"No script name was specified" = "未指定指令碼名稱";
"Script not found" = "未找到指令碼";
"No string to invoke was specified" = "未指定要叫用的字串";

/* iTermNewWindowCommand.m / iTermWindowScriptingImpl.m - 視窗命令 */
"No profile exists named '%@'" = "不存在名為 '%@' 的設定檔";
"No profile name was specified" = "未指定設定檔名稱";
