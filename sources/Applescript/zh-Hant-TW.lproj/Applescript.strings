/* iTermRequestCookieCommand.m - Cookie 請求命令 */
"The Python API is not enabled." = "Python API 未啟用。";
"An app" = "某個應用";
"%@ requests a reusable API cookie." = "%@ 請求一個可重用的 API cookie。";
"_24 Hours" = "_24 小時";
"Forever" = "永久";
"Always Allow All Apps" = "始終允許所有應用";
"Deny" = "拒絕";
"User denied the reusable cookie request." = "使用者拒絕了可重用 cookie 請求。";

