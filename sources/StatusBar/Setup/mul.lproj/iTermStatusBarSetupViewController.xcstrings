    "h3F-Ct-TxA.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"The tight packing algorithm allows more status bar components to be visible at a time but they tend to jump around more.\"; ObjectID = \"h3F-Ct-TxA\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The tight packing algorithm allows more status bar components to be visible at a time but they tend to jump around more."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧凑排列算法允许同时显示更多状态栏组件，但它们往往跳动更频繁。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧凑排列算法允许同时显示更多状态栏组件，但它们往往跳动更频繁。"
          }
        },
        "zh-Hans-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧凑排列算法允许同时显示更多状态栏组件，但它们往往跳动更频繁。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊湊排列演算法允許同時顯示更多狀態列元件，但它們往往跳動更頻繁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊湊排列演算法允許同時顯示更多狀態列元件，但它們往往跳動更頻繁。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊湊排列演算法允許同時顯示更多狀態列元件，但它們往往跳動更頻繁。"
          }
        }
      }
    },
