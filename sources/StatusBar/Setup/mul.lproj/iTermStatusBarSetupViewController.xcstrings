    "0yl-ll-bce.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Drag a component from the menu to Active Components to add it to your status bar.\"; ObjectID = \"0yl-ll-bce\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag a component from the menu to Active Components to add it to your status bar."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从菜单拖动组件到“活跃组件”以将其添加到状态栏。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从菜单拖动组件到“活跃组件”以将其添加到状态栏。"
          }
        },
        "zh-Hans-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从菜单拖动组件到“活跃组件”以将其添加到状态栏。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從選單拖曳元件到「使用中元件」以將其新增到狀態列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從選單拖曳元件到「使用中元件」以將其新增到狀態列。"
          }
        },
        "zh-Hant-TW" : {
