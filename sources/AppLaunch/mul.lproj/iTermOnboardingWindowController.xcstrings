{
    "sourceLanguage": "en",
    "strings": {
        "0Bk-78-p2L.title": {
            "comment": "Class = \"NSTextFieldCell\"; title = \"Use iTerm2 while you are apart from your Mac. You can control it via AI chat, view session content, and receive push notifications. End-to-end encryption keeps your data safe. <a href=\\\"iterm2whatsnew:companion\\\">Try it now!</a>\"; ObjectID = \"0Bk-78-p2L\";",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Use iTerm2 while you are apart from your Mac. You can control it via AI chat, view session content, and receive push notifications. End-to-end encryption keeps your data safe. <a href=\"iterm2whatsnew:companion\">Try it now!</a>"
                    }
                },
                "zh_CN": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "离开 Mac 时也能使用 iTerm2。您可以通过 AI 对话控制它、查看会话内容并接收推送通知。端到端加密保护您的数据安全。<a href=\"iterm2whatsnew:companion\">立即体验！</a>"
                    }
                },
                "zh_TW": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "離開 Mac 時也能使用 iTerm2。您可以透過 AI 對話控制它、檢視工作階段內容並接收推播通知。端對端加密保護您的資料安全。<a href=\"iterm2whatsnew:companion\">立即體驗！</a>"
                    }
                },
                "zh-Hans": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "离开 Mac 时也能使用 iTerm2。您可以通过 AI 对话控制它、查看会话内容并接收推送通知。端到端加密保护您的数据安全。<a href=\"iterm2whatsnew:companion\">立即体验！</a>"
                    }
                },
                "zh-Hans-CN": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "离开 Mac 时也能使用 iTerm2。您可以通过 AI 对话控制它、查看会话内容并接收推送通知。端到端加密保护您的数据安全。<a href=\"iterm2whatsnew:companion\">立即体验！</a>"
                    }
                },
                "zh-Hant": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "離開 Mac 時也能使用 iTerm2。您可以透過 AI 對話控制它、檢視工作階段內容並接收推播通知。端對端加密保護您的資料安全。<a href=\"iterm2whatsnew:companion\">立即體驗！</a>"
                    }
                },
                "zh-Hant-TW": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "離開 Mac 時也能使用 iTerm2。您可以透過 AI 對話控制它、檢視工作階段內容並接收推播通知。端對端加密保護您的資料安全。<a href=\"iterm2whatsnew:companion\">立即體驗！</a>"
                    }
                }
            }
        },
