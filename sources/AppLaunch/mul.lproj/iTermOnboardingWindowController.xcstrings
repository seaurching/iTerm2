        "HuW-TG-xrj.title": {
            "comment": "Class = \"NSTextFieldCell\"; title = \"To help manage a large number of tabs, you can now combine tabs into collapsible groups. The tab bar now scrolls instead of showing an overflow menu, too.\"; ObjectID = \"HuW-TG-xrj\";",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "To help manage a large number of tabs, you can now combine tabs into collapsible groups. The tab bar now scrolls instead of showing an overflow menu, too."
                    }
                },
                "zh_CN": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "为了帮助管理大量标签页，您现在可以将标签页组合成可折叠的分组。标签栏现在也改为滚动显示，而不是显示溢出菜单。"
                    }
                },
                "zh_TW": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "為了幫助管理大量標籤頁，您現在可以將標籤頁組合成可摺疊的分組。標籤列現在也改為捲動顯示，而不是顯示溢位選單。"
                    }
                },
                "zh-Hans": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "为了帮助管理大量标签页，您现在可以将标签页组合成可折叠的分组。标签栏现在也改为滚动显示，而不是显示溢出菜单。"
                    }
                },
                "zh-Hans-CN": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "为了帮助管理大量标签页，您现在可以将标签页组合成可折叠的分组。标签栏现在也改为滚动显示，而不是显示溢出菜单。"
                    }
                },
                "zh-Hant": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "為了幫助管理大量標籤頁，您現在可以將標籤頁組合成可摺疊的分組。標籤列現在也改為捲動顯示，而不是顯示溢位選單。"
                    }
                },
                "zh-Hant-TW": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "為了幫助管理大量標籤頁，您現在可以將標籤頁組合成可摺疊的分組。標籤列現在也改為捲動顯示，而不是顯示溢位選單。"
                    }
                }
            }
        },
